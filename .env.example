# Server Configuration
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Database Configuration
# MongoDB Atlas M0 Free Cluster connection URI, or local mongodb://localhost:27017/strava
MONGODB_URI=mongodb://localhost:27017/strava

# Redis Configuration
# Upstash Redis URL (e.g. rediss://default:token@endpoint.upstash.io:6379) or local redis://localhost:6379
UPSTASH_REDIS_URL=redis://localhost:6379

# Better Auth Configuration
# Generate a secret: openssl rand -base64 32
BETTER_AUTH_SECRET=your_better_auth_secret_here
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (Optional in development, required for social sign-in)
# Obtain from Google Cloud Console credentials page
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email Configuration (Optional in development, uses mock if key is missing)
# Obtain from Resend dashboard api keys page
RESEND_API_KEY=
EMAIL_FROM=noreply@yourdomain.com
